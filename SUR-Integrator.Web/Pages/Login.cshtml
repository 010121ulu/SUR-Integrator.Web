@page
@model SUR_Integrator.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="card login-card">
    <h2>👤 Вход в систему</h2>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-error">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="form-group">
            <label>Логин</label>
            <input type="text" asp-for="Login" placeholder="Введите логин" required />
        </div>
        <div class="form-group">
            <label>Пароль</label>
            <input type="password" asp-for="Password" placeholder="Введите пароль" required />
        </div>
        <button type="submit" class="btn-submit">Войти</button>
    </form>
</div>